<Window x:Class="Marte.WPF.Views.CategoryManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Categorías - MARTE" 
    Height="600"
    Width="1000"
    WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="/Images/Marte-Ico.ico">

    <Window.Resources>
        <!-- Fuente Cinzel -->
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <!-- Estilo para botones -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFEEE"/>
                                <Setter Property="Foreground" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo para filas del DataGrid -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8B0000"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#CC8B0000" 
                BorderBrush="#8B0000" 
                BorderThickness="2" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="GESTIÓN DE CATEGORÍAS" 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Categorías -->
            <Border Grid.Column="0" 
                    Background="#CC000000" 
                    BorderBrush="#8B0000" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="CATEGORÍAS REGISTRADAS" 
                              FontFamily="{StaticResource CinzelFont}"
                              FontSize="16" 
                              FontWeight="Bold" 
                              Foreground="White"
                              Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding Categorias}"
                             SelectedItem="{Binding SelectedCategoria}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             Background="#2D2D30"
                             Foreground="White"
                             BorderBrush="#8B0000"
                             GridLinesVisibility="None"
                             HeadersVisibility="Column"
                             SelectionMode="Single"
                             IsReadOnly="True"
                             RowStyle="{StaticResource DataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" 
                                              Binding="{Binding Nombre}" 
                                              Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#8B0000"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario de Edición -->
            <Border Grid.Column="1" 
                    Background="#CC000000" 
                    BorderBrush="#8B0000" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FORMULARIO DE CATEGORÍA" 
                                  FontFamily="{StaticResource CinzelFont}"
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  Margin="0,0,0,20"/>

                        <!-- Nombre de Categoría -->
                        <Label Content="Nombre de Categoría:"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding IsReadOnly}"
                                Margin="0,0,0,20"/>

                        <!-- Botones de Acción -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button Content="Nueva Categoría" 
                                   Command="{Binding NewCategoryCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                            
                            <Button Content="Guardar" 
                                   Command="{Binding SaveCategoryCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                            
                            <Button Content="Editar" 
                                   Command="{Binding EditCategoryCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                            
                            <Button Content="Cancelar" 
                                   Command="{Binding CancelCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                        </WrapPanel>

                        <Separator Margin="0,10,0,20" Background="#8B0000"/>

                        <TextBlock Text="ACCIONES AVANZADAS" 
                                  FontFamily="{StaticResource CinzelFont}"
                                  FontSize="14" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  Margin="0,0,0,15"/>

                        <Button Content="Eliminar Categoría" 
                               Command="{Binding DeleteCategoryCommand}"
                               Style="{StaticResource ActionButtonStyle}"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="⚠️ Nota: Al eliminar una categoría, se eliminará permanentemente del sistema."
                                  FontSize="11"
                                  Foreground="#FFD700"
                                  TextWrapping="Wrap"
                                  HorizontalAlignment="Center"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
