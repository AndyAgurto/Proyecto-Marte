<Window x:Class="Marte.WPF.Views.ReportesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reportes y Estadísticas - MARTE"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="/Images/Marte-Ico.ico">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Fuente Cinzel -->
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <!-- Estilo para botones -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFEEE"/>
                                <Setter Property="Foreground" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="#8B0000"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#A52A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para filas del DataGrid -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8B0000"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#CC8B0000" 
                BorderBrush="#8B0000" 
                BorderThickness="2" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <TextBlock Text="REPORTES Y ESTADÍSTICAS" 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Filtros Globales -->
        <Border Grid.Row="1"
                Background="#CC000000"
                BorderBrush="#8B0000"
                BorderThickness="2"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Fecha Inicio:" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FechaInicio}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="→" Foreground="White" FontSize="16" FontWeight="Bold" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Label Grid.Column="3" Content="Fecha Fin:" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding FechaFin}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5" 
                          Text="{Binding StatusMessage}"
                          Foreground="#AAAAAA"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- TabControl Principal -->
        <TabControl Grid.Row="2">
            <!-- TAB 1: Consultas Básicas -->
            <TabItem Header="📊 Consultas Básicas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Totales Diarios -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="TOTALES DIARIOS" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                    <Button Content="Consultar" Command="{Binding ConsultarTotalesDiariosCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarTotalesDiariosExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar PDF" Command="{Binding ExportarTotalesDiariosPDFCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </WrapPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding TotalesDiarios}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowDetailsVisibilityMode="VisibleWhenSelected"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="150"/>
                                        <DataGridTextColumn Header="Total Asistencias" Binding="{Binding TotalAsistencias}" Width="150"/>
                                        <DataGridTextColumn Header="Hasta Cierre" Binding="{Binding TotalHastaCierre}" Width="150"/>
                                        <DataGridTemplateColumn Header="Detalle" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="👁 Ver detalle" 
                                                             Foreground="#FFFEEE" 
                                                             FontSize="11" 
                                                             TextAlignment="Center"
                                                             Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    
                                    <!-- Row Details Template para mostrar asistentes -->
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E1E" 
                                                   BorderBrush="#8B0000" 
                                                   BorderThickness="1" 
                                                   Margin="50,5,5,5" 
                                                   Padding="10"
                                                   CornerRadius="4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <TextBlock Text="DETALLE DE ASISTENTES" 
                                                             FontWeight="Bold" 
                                                             FontSize="12" 
                                                             Foreground="#FFFEEE" 
                                                             Margin="0,0,0,10"/>
                                                    
                                                    <DataGrid Grid.Row="1"
                                                            ItemsSource="{Binding Asistentes}"
                                                            AutoGenerateColumns="False"
                                                            CanUserAddRows="False"
                                                            Background="#2D2D30"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            GridLinesVisibility="Horizontal"
                                                            HeadersVisibility="Column"
                                                            IsReadOnly="True"
                                                            MaxHeight="400"
                                                            HorizontalGridLinesBrush="#444444">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="100"/>
                                                            <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="250"/>
                                                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                                                            <DataGridTextColumn Header="Grupo" Binding="{Binding NumeroGrupo, TargetNullValue='-'}" Width="80"/>
                                                            <DataGridTextColumn Header="Hora Ingreso" Binding="{Binding HoraIngreso, StringFormat='hh\\:mm'}" Width="110"/>
                                                            <DataGridTextColumn Header="Hora Salida" Width="110">
                                                                <DataGridTextColumn.Binding>
                                                                    <Binding Path="HoraSalida" StringFormat="hh\:mm">
                                                                        <Binding.TargetNullValue>-</Binding.TargetNullValue>
                                                                    </Binding>
                                                                </DataGridTextColumn.Binding>
                                                            </DataGridTextColumn>
                                                            <DataGridTemplateColumn Header="Estado" Width="120">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock>
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HastaCierre}" Value="True">
                                                                                            <Setter Property="Text" Value="✓ Hasta Cierre"/>
                                                                                            <Setter Property="Foreground" Value="#90EE90"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HastaCierre}" Value="False">
                                                                                            <Setter Property="Text" Value="Salida Manual"/>
                                                                                            <Setter Property="Foreground" Value="#FFD700"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader">
                                                                <Setter Property="Background" Value="#8B0000"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Padding" Value="8,4"/>
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </Style>
                                                        </DataGrid.ColumnHeaderStyle>
                                                        <DataGrid.RowStyle>
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#3F3F46"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Por Categoría -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="POR CATEGORÍA" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                    <Button Content="Consultar" Command="{Binding ConsultarPorCategoriaCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarPorCategoriaExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar PDF" Command="{Binding ExportarPorCategoriaPDFCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </WrapPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding TotalesPorCategoria}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding NumeroGrupo}" Width="100"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                                        <DataGridTextColumn Header="Hasta Cierre" Binding="{Binding HastaCierre}" Width="120"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Por Grupo (Miembros) -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="POR GRUPO (MIEMBROS)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <Button Grid.Row="1" Content="Consultar" Command="{Binding ConsultarPorGrupoCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding TotalesPorGrupo}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding NumeroGrupo}" Width="100"/>
                                        <DataGridTextColumn Header="Total Asistencias" Binding="{Binding TotalAsistencias}" Width="*"/>
                                        <DataGridTextColumn Header="Promedio" Binding="{Binding Promedio, StringFormat='{}{0:F2}'}" Width="*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Historial Individual -->
            <TabItem Header="👤 Historial Individual">
                <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="20" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="HISTORIAL INDIVIDUAL DE ASISTENCIAS" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <!-- Búsqueda -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Búsqueda por DNI -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="DNI/Código:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DNIBusqueda, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center" Margin="10,0"/>
                                <Button Content="Consultar" Command="{Binding ConsultarHistorialPorDNICommand}" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Exportar Excel" Command="{Binding ExportarHistorialIndividualExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Exportar PDF" Command="{Binding ExportarHistorialIndividualPDFCommand}" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>

                            <!-- Búsqueda por Nombre -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Label Content="Nombres:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NombresBusqueda, UpdateSourceTrigger=PropertyChanged}" Width="150" VerticalAlignment="Center" Margin="10,0"/>
                                <Label Content="Apellidos:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                <TextBox Text="{Binding ApellidosBusqueda, UpdateSourceTrigger=PropertyChanged}" Width="150" VerticalAlignment="Center" Margin="10,0"/>
                                <Button Content="Consultar" Command="{Binding ConsultarHistorialPorNombreCommand}" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Resultados -->
                        <DataGrid Grid.Row="2"
                                 ItemsSource="{Binding HistorialIndividual}"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderBrush="#8B0000"
                                 GridLinesVisibility="None"
                                 HeadersVisibility="Column"
                                 IsReadOnly="True"
                                 RowStyle="{StaticResource DataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="Hora Ingreso" Binding="{Binding HoraIngreso, StringFormat='hh\\:mm'}" Width="120"/>
                                <DataGridTextColumn Header="Hora Salida" Binding="{Binding HoraSalida, StringFormat='hh\\:mm'}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Hasta Cierre" Binding="{Binding HastaCierre}" Width="120"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8B0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: Paneles Analíticos -->
            <TabItem Header="📈 Paneles Analíticos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Puntualidad -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="TASA DE PUNTUALIDAD" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Hora límite:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding HoraPuntualidad, StringFormat='hh\\:mm'}" Width="80" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock Text="(Formato: 19:30)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="10,0,20,0"/>
                                    <Button Content="Consultar" Command="{Binding ConsultarPuntualidadCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarPuntualidadExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding ReportePuntualidad}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="90"/>
                                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                        <DataGridTextColumn Header="Total Asist." Binding="{Binding TotalAsistencias}" Width="90"/>
                                        <DataGridTextColumn Header="Puntuales" Binding="{Binding AsistenciasPuntuales}" Width="90"/>
                                        <DataGridTextColumn Header="% Puntual" Binding="{Binding PorcentajePuntualidad, StringFormat='{}{0}%'}" Width="90"/>
                                        <DataGridTextColumn Header="Prom. Ingreso" Binding="{Binding PromedioHoraIngreso, StringFormat='hh\\:mm'}" Width="110"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Hasta Cierre -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ASISTENTES HASTA CIERRE" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                    <Button Content="Consultar" Command="{Binding ConsultarHastaCierreCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarHastaCierreExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </WrapPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding ReporteHastaCierre}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="90"/>
                                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                                        <DataGridTextColumn Header="Total Días" Binding="{Binding TotalDias}" Width="100"/>
                                        <DataGridTextColumn Header="Días Hasta Cierre" Binding="{Binding DiasHastaCierre}" Width="140"/>
                                        <DataGridTextColumn Header="% Hasta Cierre" Binding="{Binding PorcentajeHastaCierre, StringFormat='{}{0}%'}" Width="130"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Por Grupo Detalle -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ASISTENCIA POR GRUPO (DETALLE)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                    <Button Content="Consultar" Command="{Binding ConsultarPorGrupoDetalleCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarPorGrupoDetalleExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </WrapPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding ReportePorGrupoDetalle}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding NumeroGrupo}" Width="80"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                        <DataGridTextColumn Header="Total Miembros" Binding="{Binding TotalMiembrosGrupo}" Width="120"/>
                                        <DataGridTextColumn Header="Asistieron" Binding="{Binding AsistentesDelGrupo}" Width="100"/>
                                        <DataGridTextColumn Header="% Asist." Binding="{Binding PorcentajeAsistencia, StringFormat='{}{0}%'}" Width="90"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Día Mayor Asistencia -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="DÍA DE MAYOR ASISTENCIA" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <Button Grid.Row="1" Content="Consultar" Command="{Binding ConsultarDiaMayorAsistenciaCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                                <Border Grid.Row="2" 
                                       Background="#2D2D30"
                                       BorderBrush="#8B0000"
                                       BorderThickness="1"
                                       CornerRadius="4"
                                       Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FECHA" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding DiaMayorAsistencia.Fecha, StringFormat='dd/MM/yyyy', TargetNullValue='-'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding DiaMayorAsistencia.DiaSemana, TargetNullValue=''}" FontSize="14" Foreground="#FFFEEE"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL ASISTENCIAS" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding DiaMayorAsistencia.TotalAsistencias, TargetNullValue='0'}" FontSize="32" FontWeight="Bold" Foreground="#8B0000"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Top Constantes -->
                        <Border Background="#CC000000" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="300"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="TOP ASISTENTES MÁS CONSTANTES" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Top:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding TopConstantes}" Width="60" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Content="Consultar" Command="{Binding ConsultarTopConstantesCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Exportar Excel" Command="{Binding ExportarTopConstantesExcelCommand}" Style="{StaticResource ActionButtonStyle}"/>
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding TopAsistentesConstantes}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         Background="#2D2D30"
                                         Foreground="White"
                                         BorderBrush="#8B0000"
                                         GridLinesVisibility="None"
                                         HeadersVisibility="Column"
                                         IsReadOnly="True"
                                         RowStyle="{StaticResource DataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pos." Binding="{Binding Posicion}" Width="50"/>
                                        <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="90"/>
                                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding NumeroGrupo}" Width="70"/>
                                        <DataGridTextColumn Header="Total Asist." Binding="{Binding TotalAsistencias}" Width="100"/>
                                        <DataGridTextColumn Header="% Asist." Binding="{Binding PorcentajeAsistencia, StringFormat='{}{0}%'}" Width="90"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#8B0000"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Loading indicator -->
        <Border Grid.Row="3" 
                Background="#CC8B0000"
                BorderBrush="#8B0000"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10"
                Margin="0,15,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Procesando..." 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="14"
                      FontWeight="Bold"
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
