<Window x:Class="Marte.WPF.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar Contraseña" 
        Height="450" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        Icon="/Images/Marte-Ico.ico">

    <Window.Resources>
        <!-- Fuente Cinzel -->
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <!-- Estilo para botones -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A00000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#600000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="#CC000000" 
            BorderBrush="#8B0000" 
            BorderThickness="2" 
            CornerRadius="8" 
            Margin="10"
            Padding="20">
        <StackPanel>
            <TextBlock Text="🔑 CAMBIAR CONTRASEÑA" 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <Label Content="Usuario:"/>
            <TextBlock x:Name="txtUsuario"
                      Text="[Usuario]"
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="13"
                      FontWeight="Bold"
                      Foreground="#FFD700"
                      Margin="0,0,0,15"/>

            <Label Content="Nueva Contraseña:"/>
            <PasswordBox x:Name="txtNuevaContraseña"
                        Margin="0,0,0,15"/>

            <Label Content="Confirmar Contraseña:"/>
            <PasswordBox x:Name="txtConfirmarContraseña"
                        Margin="0,0,0,5"/>
            
            <TextBlock x:Name="txtError"
                      FontSize="11"
                      Foreground="#FF6B6B"
                      TextWrapping="Wrap"
                      Margin="0,5,0,20"
                      Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center">
                <Button Content="Aceptar" 
                       Click="OnAceptarClick"
                       Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="Cancelar" 
                       Click="OnCancelarClick"
                       Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
