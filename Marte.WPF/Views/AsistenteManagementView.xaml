<Window x:Class="Marte.WPF.Views.AsistenteManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestión de Asistentes - MARTE"
        Height="800" 
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="/Images/Marte-Ico.ico">

    <Window.Resources>
        <!-- Fuente Cinzel -->
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <!-- Estilo para botones -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFEEE"/>
                                <Setter Property="Foreground" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo para CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para filas del DataGrid -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8B0000"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#CC8B0000" 
                BorderBrush="#8B0000" 
                BorderThickness="2" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="GESTIÓN DE ASISTENTES" 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Lista de Asistentes + Botones -->
            <Border Grid.Column="0" 
                    Background="#CC000000" 
                    BorderBrush="#8B0000" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título de la lista -->
                    <TextBlock Grid.Row="0" 
                              Text="ASISTENTES REGISTRADOS" 
                              FontFamily="{StaticResource CinzelFont}"
                              FontSize="16" 
                              FontWeight="Bold" 
                              Foreground="White"
                              Margin="0,0,0,15"/>

                    <!-- Filtro: Mostrar solo activos -->
                    <CheckBox Grid.Row="1"
                              Content="Mostrar solo activos"
                              IsChecked="{Binding MostrarSoloActivos}"
                              Margin="0,0,0,10"/>

                    <!-- DataGrid de Asistentes -->
                    <DataGrid Grid.Row="2"
                             ItemsSource="{Binding Asistentes}"
                             SelectedItem="{Binding SelectedAsistente}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             Background="#2D2D30"
                             Foreground="White"
                             BorderBrush="#8B0000"
                             GridLinesVisibility="None"
                             HeadersVisibility="Column"
                             SelectionMode="Single"
                             IsReadOnly="True"
                             RowStyle="{StaticResource DataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI/Código" 
                                              Binding="{Binding DNI}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Apellidos" 
                                              Binding="{Binding Apellidos}" 
                                              Width="*"/>
                            <DataGridTextColumn Header="Nombres" 
                                              Binding="{Binding Nombres}" 
                                              Width="*"/>
                            <DataGridTextColumn Header="Categoría" 
                                              Binding="{Binding Categoria.Nombre}" 
                                              Width="120"/>
                            <DataGridTextColumn Header="Grupo" 
                                              Binding="{Binding NumeroGrupo}" 
                                              Width="60"/>
                            <DataGridTemplateColumn Header="Estado" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Estado, Converter={StaticResource BoolToEstadoConverter}}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#8B0000"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>

                    <!-- Botones de Acción -->
                    <WrapPanel Grid.Row="3" 
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0">
                        <Button Content="Nuevo" 
                               Command="{Binding NewAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Guardar" 
                               Command="{Binding SaveAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Editar" 
                               Command="{Binding EditAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Cancelar" 
                               Command="{Binding CancelCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Inactivar" 
                               Command="{Binding InactivarAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Activar" 
                               Command="{Binding ActivarAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                        
                        <Button Content="Eliminar" 
                               Command="{Binding DeleteAsistenteCommand}"
                               Style="{StaticResource ActionButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Panel Derecho: Formulario de Edición -->
            <Border Grid.Column="1" 
                    Background="#CC000000" 
                    BorderBrush="#8B0000" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FORMULARIO DE ASISTENTE" 
                                  FontFamily="{StaticResource CinzelFont}"
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  Margin="0,0,0,20"/>

                        <!-- DNI/Código -->
                        <Label Content="DNI/Código:"/>
                        <TextBox Text="{Binding DNI, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding IsDNIReadOnly}"
                                Margin="0,0,0,15"/>

                        <!-- Nombres -->
                        <Label Content="Nombres:"/>
                        <TextBox Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding IsFormReadOnly}"
                                Margin="0,0,0,15"/>

                        <!-- Apellidos -->
                        <Label Content="Apellidos:"/>
                        <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding IsFormReadOnly}"
                                Margin="0,0,0,15"/>

                        <!-- Categoría -->
                        <Label Content="Categoría:"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                 SelectedItem="{Binding SelectedCategoria, Mode=TwoWay}"
                                 DisplayMemberPath="Nombre"
                                 IsEnabled="{Binding IsCategoriaEnabled}"
                                 Margin="0,0,0,15"/>

                        <!-- Número de Grupo (solo visible para categoría "Miembros") -->
                        <Label Content="Número de Grupo:"
                               Visibility="{Binding IsNumeroGrupoVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBox Text="{Binding NumeroGrupo, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNumeroGrupoEnabled}"
                                 Visibility="{Binding IsNumeroGrupoVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                 MaxLength="2"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="(Formato: 01, 02, 03...)"
                                   FontSize="10"
                                   Foreground="#AAAAAA"
                                   Visibility="{Binding IsNumeroGrupoVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,0,0,15"/>

                        <!-- Información adicional -->
                        <Border Background="#2D2D30"
                                BorderBrush="#8B0000"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="INFORMACIÓN" 
                                          FontFamily="{StaticResource CinzelFont}"
                                          FontSize="12" 
                                          FontWeight="Bold" 
                                          Foreground="White"
                                          Margin="0,0,0,10"/>
                                <TextBlock FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap">
                                    <Run Text="• El DNI/Código es único y no puede modificarse después de creado."/>
                                    <LineBreak/>
                                    <Run Text="• El Número de Grupo solo es requerido para la categoría 'Miembros'."/>
                                    <LineBreak/>
                                    <Run Text="• Use INACTIVAR para dar de baja temporalmente (reversible)."/>
                                    <LineBreak/>
                                    <Run Text="• Use ELIMINAR solo para borrados permanentes."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
