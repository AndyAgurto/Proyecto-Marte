<Window x:Class="Marte.WPF.Views.AsistenciaControlView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Control de Asistencia - MARTE"
    Height="700"
    Width="1200"
    WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Icon="/Images/Marte-Ico.ico">

    <Window.Resources>
        <!-- Fuente Cinzel -->
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <!-- Estilo para botones -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFEEE"/>
                                <Setter Property="Foreground" Value="#8B0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <!-- Estilo para filas del DataGrid -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8B0000"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#CC8B0000" 
                BorderBrush="#8B0000" 
                BorderThickness="2" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock Text="CONTROL DE ASISTENCIA" 
                      FontFamily="{StaticResource CinzelFont}"
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel Superior: Registro de Ingreso -->
            <Border Grid.Row="0" 
                    Background="#CC000000" 
                    BorderBrush="#8B0000" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="REGISTRAR INGRESO" 
                              FontFamily="{StaticResource CinzelFont}"
                              FontSize="16" 
                              FontWeight="Bold" 
                              Foreground="White"
                              Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="DNI/Código/Nombre:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding DNIBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding RegistrarIngresoDinamicoCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Grid.Column="2"
                                Content="Registro Rápido"
                                Command="{Binding RegistrarIngresoDinamicoCommand}"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Grid.Column="3"
                                Content="Visitante Temporal"
                                Command="{Binding RegistrarIngresoTemporalCommand}"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <TextBlock Grid.Column="4"
                                   Text="Presione ENTER para registro rápido"
                                   FontSize="11"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Panel Inferior: Dos columnas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Asistentes Presentes -->
                <Border Grid.Column="0" 
                        Background="#CC000000" 
                        BorderBrush="#8B0000" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="15"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="ASISTENTES PRESENTES" 
                                      FontFamily="{StaticResource CinzelFont}"
                                      FontSize="16" 
                                      FontWeight="Bold" 
                                      Foreground="White"/>
                            <TextBlock FontSize="12" Foreground="#CCCCCC" Margin="0,5,0,0">
                                <Run Text="Total presentes: "/>
                                <Run Text="{Binding TotalPresentes, Mode=OneWay}" FontWeight="Bold" Foreground="#8B0000"/>
                                <Run Text=" | Actualización automática cada 30 seg."/>
                            </TextBlock>
                        </StackPanel>

                        <!-- DataGrid de Presentes -->
                        <DataGrid Grid.Row="1"
                                 ItemsSource="{Binding AsistenciasPresentes}"
                                 SelectedItem="{Binding SelectedAsistenciaPresente}"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderBrush="#8B0000"
                                 GridLinesVisibility="None"
                                 HeadersVisibility="Column"
                                 SelectionMode="Single"
                                 IsReadOnly="True"
                                 RowStyle="{StaticResource DataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DNI" 
                                                  Binding="{Binding Asistente.DNI}" 
                                                  Width="90"/>
                                <DataGridTextColumn Header="Apellidos" 
                                                  Binding="{Binding Asistente.Apellidos}" 
                                                  Width="*"/>
                                <DataGridTextColumn Header="Nombres" 
                                                  Binding="{Binding Asistente.Nombres}" 
                                                  Width="*"/>
                                <DataGridTextColumn Header="Categoría" 
                                                  Binding="{Binding Asistente.Categoria.Nombre}" 
                                                  Width="100"/>
                                <DataGridTextColumn Header="Ingreso" 
                                                  Binding="{Binding HoraIngreso, StringFormat='HH:mm'}" 
                                                  Width="70"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8B0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>

                        <!-- Observación -->
                        <StackPanel Grid.Row="2" Margin="0,15,0,10">
                            <Label Content="Observación (opcional):"/>
                            <TextBox Text="{Binding ObservacionSalida, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     MaxLength="200"
                                     Height="60"/>
                        </StackPanel>

                        <!-- Botones -->
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Center">
                            <Button Content="Registrar Salida"
                                   Command="{Binding RegistrarSalidaCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                            
                            <Button Content="Aplicar Cierre"
                                   Command="{Binding AplicarCierreCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                            
                            <Button Content="Actualizar"
                                   Command="{Binding ActualizarCommand}"
                                   Style="{StaticResource ActionButtonStyle}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Columna Derecha: Historial del Día -->
                <Border Grid.Column="1" 
                        Background="#CC000000" 
                        BorderBrush="#8B0000" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="20"
                        Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0"
                                  Text="HISTORIAL DEL DÍA (HOY)" 
                                  FontFamily="{StaticResource CinzelFont}"
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  Margin="0,0,0,10"/>

                        <!-- Búsqueda en tabla -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Buscar en tabla:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BusquedaAsistencia, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" 
                                     Margin="5,0"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding BuscarAsistenciaCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Buscar" 
                                    Command="{Binding BuscarAsistenciaCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    MinWidth="80"
                                    Padding="15,8"/>
                        </StackPanel>

                        <!-- DataGrid de Historial -->
                        <DataGrid Grid.Row="2"
                                 ItemsSource="{Binding HistorialDia}"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 Background="#2D2D30"
                                 Foreground="White"
                                 BorderBrush="#8B0000"
                                 GridLinesVisibility="None"
                                 HeadersVisibility="Column"
                                 SelectionMode="Single"
                                 IsReadOnly="True"
                                 RowStyle="{StaticResource DataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DNI" 
                                                  Binding="{Binding Asistente.DNI}" 
                                                  Width="90"/>
                                <DataGridTextColumn Header="Apellidos" 
                                                  Binding="{Binding Asistente.Apellidos}" 
                                                  Width="*"/>
                                <DataGridTextColumn Header="Nombres" 
                                                  Binding="{Binding Asistente.Nombres}" 
                                                  Width="*"/>
                                <DataGridTextColumn Header="Ingreso" 
                                                  Binding="{Binding HoraIngreso, StringFormat='HH:mm'}" 
                                                  Width="70"/>
                                <DataGridTextColumn Header="Salida" 
                                                  Binding="{Binding HoraSalida, StringFormat='HH:mm'}" 
                                                  Width="70"/>
                                <DataGridCheckBoxColumn Header="Cierre" 
                                                      Binding="{Binding HastaCierre}" 
                                                      Width="60"/>
                                <DataGridTextColumn Header="Observación" 
                                                  Binding="{Binding Observacion}" 
                                                  Width="150"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8B0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
