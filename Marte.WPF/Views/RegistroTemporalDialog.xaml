<Window x:Class="Marte.WPF.Views.RegistroTemporalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Visitante Temporal"
        Height="380"
        Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Icon="/Images/Marte-Ico.ico"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="CinzelFont">Times New Roman</FontFamily>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFEEE"/>
                                <Setter Property="Foreground" Value="#8B0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="REGISTRO DE VISITANTE TEMPORAL"
                   FontFamily="{StaticResource CinzelFont}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#8B0000"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="Nombres:"/>
            <TextBox x:Name="txtNombres" MaxLength="100"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Label Content="Apellidos:"/>
            <TextBox x:Name="txtApellidos" MaxLength="100"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   x:Name="txtError"
                   Text=""
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   FontSize="11"/>

        <Border Grid.Row="4"
                Background="#2D2D30"
                BorderBrush="#8B0000"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,15">
            <TextBlock Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap">
                <Run Text="ℹ️ Use esta opción solo para visitantes ocasionales."/>
                <LineBreak/>
                <Run Text="• Se asignará un código temporal automáticamente"/>
                <LineBreak/>
                <Run Text="• El registro se guardará en la categoría 'Otros'"/>
                <LineBreak/>
                <Run Text="• Para asistentes regulares, use la Gestión de Asistentes"/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Registrar" 
                    Click="BtnRegistrar_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="Cancelar" 
                    Click="BtnCancelar_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
